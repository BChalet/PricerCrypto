{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Live": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5106",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "Live + enregistrement": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5106",
      "commandLineArgs": "--MarketData:Record=true",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "Rejeu": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5106",
      "commandLineArgs": "--MarketData:Mode=Replay",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  }
}
