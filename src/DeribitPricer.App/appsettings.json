// La config de l'appli. C'est ici qu'on passe de Live à Replay, qu'on active l'enregistrement et qu'on choisit le fichier à rejouer.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MarketData": {
    "Mode": "Live",
    "Currencies": [ "BTC", "ETH" ],
    "RestBaseUrl": "https://www.deribit.com/api/v2/",
    "WebSocketUrl": "wss://www.deribit.com/ws/api/v2",
    "MaxRequestsPerSecond": 5,
    "MaxBurst": 5,
    "SummaryPollSeconds": 5,
    "ReferenceRefreshMinutes": 10,
    "TickerInterval": "100ms",
    "Record": false,
    "RecordDirectory": "data/recordings",
    "ReplayFile": "data/recordings/deribit-20261015-133532.jsonl.gz",
    "ReplaySpeed": 1 // Vitesse du rejeu, mettre 1 pour la vitesse réelle, 2 pour le double, etc....
  },

  "App": {
    "RefreshMilliseconds": 1000,
    "BlotterFile": "data/blotter.json",
    "ReplayBlotterFile": "data/blotter-replay.json",
    "ResetReplayBlotterOnStart": true
  }
}
